# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
services/api/vendor/
services/mobile/.dart_tool/
services/mobile/build/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
*.env
.env*.local

# Firebase service account keys
services/api/storage/firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

FINAL_STATUS.txt
# Ignore all markdown files
*.md

.qodo
.claude/settings.local.json

# Log files
*.log
firebase_auth_cache.txt
services/api/.phpunit.cache/
services/api/storage/logs/

# But do NOT ignore README.md and DOCUMENTATION folder
!README.md
!DOCUMENTATION/
!DOCUMENTATION/**/*.md
DOCUMENTATION/TASKS.md

# Local Firebase service account and runtime storage
storage/

# Local release binaries
/dist/
services/mobile/build/


# Local secrets (upload keystore, credentials)
/secrets/


# Mobile Firebase Android config (use Console download + CI secret)
**/google-services.json

