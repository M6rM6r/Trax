# ===========================================
# Trax Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in values

# App
NEXT_PUBLIC_APP_NAME=Trax
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# API (when backend is ready)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_PRODUCTION_API_URL=https://api.trax.app/api
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Map
NEXT_PUBLIC_DEFAULT_MAP_LAT=24.7136
NEXT_PUBLIC_DEFAULT_MAP_LNG=46.6753
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=12

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=

# Feature Flags
NEXT_PUBLIC_FEATURE_LIVE_TRACKING=true
NEXT_PUBLIC_FEATURE_GEOFENCES=true
NEXT_PUBLIC_FEATURE_ATTENDANCE_REPORTS=true
NEXT_PUBLIC_FEATURE_EXPORT_EXCEL=true

# AI Service
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001

# Redis / Cache
REDIS_URL=redis://localhost:6379/0
AI_CACHE_TTL=300

# Logging
AI_LOG_LEVEL=INFO
