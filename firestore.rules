rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userCompanyId() {
      return signedIn()
        ? (exists(/databases/$(database)/documents/users/$(request.auth.uid))
           ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.company_id
           : null)
        : null;
    }

    function sameCompany(doc) {
      return signedIn()
        && 'company_id' in doc.data
        && doc.data.company_id == userCompanyId();
    }

    function owns(resource) {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isCompanyOwner(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        uid == request.auth.uid
        || sameCompany(resource)
      );
      allow create: if signedIn() && (uid == request.auth.uid || sameCompany(request.resource));
      allow update: if signedIn() && (uid == request.auth.uid || sameCompany(resource));
      allow delete: if signedIn() && (uid == request.auth.uid || sameCompany(resource));
    }

    match /companies/{companyId} {
      allow read: if signedIn() && (companyId == userCompanyId() || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && (companyId == userCompanyId() || resource.data.ownerId == request.auth.uid);
    }

    match /company_settings/{settingsId} {
      allow read: if signedIn() && (settingsId == userCompanyId() || sameCompany(resource));
      allow create: if signedIn() && (settingsId == userCompanyId() || sameCompany(request.resource));
      allow update, delete: if signedIn() && (settingsId == userCompanyId() || sameCompany(resource));
    }

    match /employees/{employeeId} {
      allow read: if signedIn() && (
        sameCompany(resource)
        || resource.data.authUid == request.auth.uid
        || resource.data.email == request.auth.token.email
        || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id))
      );
      allow create: if sameCompany(request.resource);
      allow update, delete: if sameCompany(resource);
    }

    match /geofences/{geofenceId} {
      allow read: if signedIn() && (sameCompany(resource) || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id)));
      allow create: if sameCompany(request.resource);
      allow update, delete: if sameCompany(resource);
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn() && (sameCompany(resource) || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id)));
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && sameCompany(request.resource);
      allow update, delete: if sameCompany(resource);
    }

    match /locations/{employeeId} {
      allow read: if signedIn() && sameCompany(resource);
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && sameCompany(request.resource);
      allow delete: if signedIn() && owns(resource)
        && sameCompany(resource);
    }

    match /notifications/{notifId} {
      allow read: if signedIn() && sameCompany(resource);
      allow create: if signedIn() && sameCompany(request.resource);
      allow update, delete: if signedIn() && sameCompany(resource);
    }

    match /fcm_tokens/{token} {
      allow read: if sameCompany(resource);
      allow create, update: if signedIn()
        && sameCompany(request.resource);
      allow delete: if signedIn() && (sameCompany(resource) || request.auth.uid == resource.data.ownerUid);
    }

    match /notification_settings/{userId} {
      allow read, write: if signedIn() && userId == request.auth.uid;
    }

    match /attendance_summaries/{summaryId} {
      allow read: if signedIn() && (sameCompany(resource) || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id)));
      allow write: if false;
    }

    match /deleted_users/{uid} {
      allow read: if sameCompany(resource);
      allow write: if false;
    }

    match /cache/{cacheKey} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data == null || resource.data.ownerUid == request.auth.uid);
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /company_cache/{companyId} {
      allow read: if signedIn() && companyId == userCompanyId();
      allow write: if signedIn() && companyId == userCompanyId();
    }

    match /function_metrics/{metricId} {
      allow read: if false;
      allow write: if false;
    }

    match /function_metrics_hourly/{metricId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
