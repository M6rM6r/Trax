rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userCompanyId() {
      return signedIn()
        ? (exists(/databases/$(database)/documents/users/$(request.auth.uid))
           ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.company_id
           : null)
        : null;
    }

    function sameCompany(doc) {
      return signedIn()
        && 'company_id' in doc.data
        && doc.data.company_id == userCompanyId();
    }

    function owns(resource) {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isCompanyOwner(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid;
    }

    function isMastermind(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == "mastermind";
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        uid == request.auth.uid
        || sameCompany(resource)
      );
      // Self-create only. Cross-user user docs are written by Admin SDK / Cloud Functions.
      allow create: if signedIn() && uid == request.auth.uid;
      // Self may update non-privileged fields only. Role / company / employee linkage are immutable from clients.
      allow update: if signedIn() && uid == request.auth.uid
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (!('admin_role' in request.resource.data) || request.resource.data.admin_role == resource.data.get('admin_role', null))
        && (!('company_id' in request.resource.data) || request.resource.data.company_id == resource.data.get('company_id', null))
        && (!('employee_id' in request.resource.data) || request.resource.data.employee_id == resource.data.get('employee_id', null));
      allow delete: if signedIn() && uid == request.auth.uid;
    }

    match /companies/{companyId} {
      allow read: if signedIn() && (companyId == userCompanyId() || resource.data.ownerId == request.auth.uid || isMastermind(request.auth.uid));
      allow create: if signedIn() && (request.resource.data.ownerId == request.auth.uid || isMastermind(request.auth.uid));
      allow update, delete: if signedIn() && (companyId == userCompanyId() || resource.data.ownerId == request.auth.uid || isMastermind(request.auth.uid));
    }

    match /company_settings/{settingsId} {
      allow read: if signedIn() && (settingsId == userCompanyId() || sameCompany(resource));
      allow create: if signedIn() && (settingsId == userCompanyId() || sameCompany(request.resource));
      allow update, delete: if signedIn() && (settingsId == userCompanyId() || sameCompany(resource));
    }

    match /employees/{employeeId} {
      // No bare email match — that allowed cross-tenant reads when emails collided.
      allow read: if signedIn() && (
        sameCompany(resource)
        || resource.data.authUid == request.auth.uid
        || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id))
        || isMastermind(request.auth.uid)
      );
      allow create: if sameCompany(request.resource)
        && !('password' in request.resource.data);
      allow update: if sameCompany(resource)
        && !('password' in request.resource.data);
      allow delete: if sameCompany(resource);
    }

    match /geofences/{geofenceId} {
      allow read: if signedIn() && (sameCompany(resource) || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id)) || isMastermind(request.auth.uid));
      allow create: if sameCompany(request.resource);
      allow update, delete: if sameCompany(resource);
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn() && (sameCompany(resource) || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id)) || isMastermind(request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && sameCompany(request.resource);
      allow update, delete: if sameCompany(resource);
    }

    match /locations/{employeeId} {
      allow read: if signedIn() && sameCompany(resource);
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && sameCompany(request.resource);
      allow delete: if signedIn() && owns(resource)
        && sameCompany(resource);
    }

    match /notifications/{notifId} {
      allow read: if signedIn() && sameCompany(resource);
      allow create: if signedIn() && sameCompany(request.resource);
      allow update, delete: if signedIn() && sameCompany(resource);
    }

    match /fcm_tokens/{token} {
      allow read: if sameCompany(resource);
      allow create, update: if signedIn()
        && sameCompany(request.resource);
      allow delete: if signedIn() && (sameCompany(resource) || request.auth.uid == resource.data.ownerUid);
    }

    match /notification_settings/{userId} {
      allow read, write: if signedIn() && userId == request.auth.uid;
    }

    match /attendance_summaries/{summaryId} {
      allow read: if signedIn() && (sameCompany(resource) || ('company_id' in resource.data && isCompanyOwner(resource.data.company_id)) || isMastermind(request.auth.uid));
      allow write: if false;
    }

    match /deleted_users/{uid} {
      allow read: if sameCompany(resource);
      allow write: if false;
    }

    match /cache/{cacheKey} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && (resource.data == null || resource.data.ownerUid == request.auth.uid);
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /company_cache/{companyId} {
      allow read: if signedIn() && companyId == userCompanyId();
      allow write: if signedIn() && companyId == userCompanyId();
    }

    match /function_metrics/{metricId} {
      allow read: if false;
      allow write: if false;
    }

    match /function_metrics_hourly/{metricId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
