rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function manager() {
      return signedIn() && request.auth.token.role in ['boss', 'manager', 'supervisor'];
    }

    function owns(resource) {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && uid == request.auth.uid;
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /employees/{employeeId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (owns(resource) || request.auth.token.role in ['boss', 'manager', 'supervisor']);
    }

    match /geofences/{geofenceId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (owns(resource) || request.auth.token.role in ['boss', 'manager', 'supervisor']);
    }

    match /locations/{employeeId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn() && (owns(resource) || request.auth.token.role in ['boss', 'manager', 'supervisor']);
    }
  }
}
