rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function manager() {
      return signedIn() && request.auth.token.role in ['boss', 'manager', 'supervisor'];
    }

    function boss() {
      return signedIn() && request.auth.token.role == 'boss';
    }

    function owns(resource) {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && (uid == request.auth.uid || manager());
      allow delete: if signedIn() && boss();
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.ownerId == request.auth.uid || boss());
    }

    match /company_settings/{settingsId} {
      allow read: if signedIn() && (settingsId == request.auth.uid || manager());
      allow write: if signedIn() && (settingsId == request.auth.uid || manager());
    }

    match /employees/{employeeId} {
      allow read: if signedIn();
      allow create: if manager();
      allow update, delete: if signedIn() && (owns(resource) || manager());
    }

    match /geofences/{geofenceId} {
      allow read: if signedIn();
      allow create, update, delete: if manager();
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (owns(resource) || manager());
    }

    match /locations/{employeeId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if signedIn() && (owns(resource) || manager());
    }
  }
}
